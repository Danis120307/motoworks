<%- include('../../partials/head') %>

<div class="card-flat overflow-hidden">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-4">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-[18px]">Data Sparepart</h2>
      <span class="label-mono"><%= pagination.total %> item</span>
    </div>
    <a href="/spareparts/new" class="btn btn-primary btn-sm">
      <%- include('../../partials/icon', { name: 'plus', className: 'h-4 w-4' }) %> Tambah Sparepart
    </a>
  </div>

  <div class="border-b border-hairline px-5 py-4">
    <form method="get" action="/spareparts" class="flex flex-wrap items-end gap-3">
      <div class="min-w-[200px] flex-1">
        <label class="label-mono" for="q">Cari</label>
        <input class="input mt-1.5" id="q" name="q" value="<%= filters.q %>" placeholder="Kode atau nama">
      </div>
      <div class="min-w-[170px]">
        <label class="label-mono" for="kategori">Kategori</label>
        <select class="input mt-1.5" id="kategori" name="kategori">
          <option value="">Semua kategori</option>
          <% categories.forEach(function (category) { %>
          <option value="<%= category.id %>" <%= String(filters.kategori) === String(category.id) ? 'selected' : '' %>>
            <%= category.namaKategori %>
          </option>
          <% }); %>
        </select>
      </div>
      <label class="flex h-11 items-center gap-2 text-[14px] text-body">
        <input type="checkbox" name="menipis" value="1" <%= filters.menipis ? 'checked' : '' %>
          class="h-4 w-4 rounded-xs border-hairline-strong bg-canvas accent-secondary">
        Stok menipis
      </label>
      <button type="submit" class="btn btn-secondary btn-sm">Terapkan</button>
      <a href="/spareparts" class="btn btn-ghost btn-sm">Reset</a>
    </form>
  </div>

  <div class="overflow-x-auto">
    <table class="table-base">
      <thead>
        <tr>
          <th>Kode</th>
          <th>Nama</th>
          <th>Kategori</th>
          <th class="text-right">Harga Beli</th>
          <th class="text-right">Harga Jual</th>
          <th class="text-right">Stok</th>
          <th class="text-right">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!parts.length) { %>
        <tr>
          <td colspan="7" class="py-10 text-center text-ash">Tidak ada sparepart yang cocok.</td>
        </tr>
        <% } %>
        <% parts.forEach(function (part) { %>
        <tr>
          <td class="font-mono text-[13px] text-ink"><%= part.kodeItem %></td>
          <td>
            <p class="text-ink"><%= part.nama %></p>
            <p class="text-[12px] text-ash"><%= part.satuan || '-' %></p>
          </td>
          <td class="text-[14px]"><%= part.category ? part.category.namaKategori : '-' %></td>
          <td class="text-right font-mono text-[13px]"><%= formatRupiah(part.hargaBeli) %></td>
          <td class="text-right font-mono text-[13px]"><%= formatRupiah(part.hargaJual) %></td>
          <td class="text-right">
            <span class="font-mono text-[14px] <%= part.stokSaatIni <= part.stokMinimum ? 'text-danger' : 'text-ink' %>">
              <%= part.stokSaatIni %>
            </span>
            <span class="font-mono text-[11px] text-mute">/ min <%= part.stokMinimum %></span>
          </td>
          <td>
            <div class="flex justify-end gap-2">
              <a href="/spareparts/<%= part.id %>/kartu-stok" class="btn btn-ghost btn-sm">Kartu Stok</a>
              <a href="/spareparts/<%= part.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/pagination') %>
<%- include('../../partials/foot') %>
