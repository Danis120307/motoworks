{
  "name": "motoworks",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Manajemen Stok & Laporan Keuangan Bengkel Motor",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently -k -n APP,CSS -c blue,magenta \"nodemon src/server.js\" \"npm:css:watch\"",
    "start": "node src/server.js",
    "css:build": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  }
}
