<%- include('../../partials/head') %>

<div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
  <div class="card h-fit xl:col-span-1">
    <h2 class="text-[18px]">Tambah Jenis Layanan</h2>
    <form method="post" action="/service-types" class="mt-4 space-y-4">
      <div>
        <label class="label-mono" for="namaLayanan">Nama Layanan</label>
        <input class="input mt-1.5" id="namaLayanan" name="namaLayanan" value="<%= values.namaLayanan || '' %>"
          placeholder="cth. Ganti Oli Mesin" required>
        <% if (errors.namaLayanan) { %><p class="error-text"><%= errors.namaLayanan[0] %></p><% } %>
      </div>
      <div>
        <label class="label-mono" for="hargaJasa">Harga Jasa (Rp)</label>
        <input class="input mt-1.5" id="hargaJasa" name="hargaJasa" type="number" min="0" step="1"
          value="<%= values.hargaJasa !== undefined ? values.hargaJasa : '' %>" required>
        <% if (errors.hargaJasa) { %><p class="error-text"><%= errors.hargaJasa[0] %></p><% } %>
      </div>
      <button type="submit" class="btn btn-primary w-full">Simpan</button>
    </form>
  </div>

  <div class="card-flat overflow-hidden xl:col-span-2">
    <div class="flex items-center justify-between border-b border-hairline px-5 py-4">
      <h2 class="text-[18px]">Daftar Jenis Layanan</h2>
      <span class="label-mono"><%= serviceTypes.length %> layanan</span>
    </div>
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr>
            <th>Nama Layanan</th>
            <th class="text-right">Harga Jasa</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!serviceTypes.length) { %>
          <tr>
            <td colspan="3" class="py-10 text-center text-ash">Belum ada jenis layanan.</td>
          </tr>
          <% } %>
          <% serviceTypes.forEach(function (serviceType) { %>
          <tr>
            <td class="text-ink"><%= serviceType.namaLayanan %></td>
            <td class="text-right font-mono text-[13px] text-ink"><%= formatRupiah(serviceType.hargaJasa) %></td>
            <td>
              <div class="flex justify-end gap-2">
                <a href="/service-types/<%= serviceType.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                <form method="post" action="/service-types/<%= serviceType.id %>/delete">
                  <button type="submit" class="btn btn-danger btn-sm" data-confirm="Hapus layanan ini?">Hapus</button>
                </form>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/foot') %>
