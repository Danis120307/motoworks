<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nota <%= order.nomorOrder %> · <%= settings.namaBengkel %></title>
  <link rel="stylesheet" href="/css/output.css">
  <style>
    @media print {
      @page { margin: 12mm; }
      body { background: #ffffff !important; }
    }
  </style>
</head>
<body class="bg-neutral-100 font-display text-neutral-900">
  <div class="no-print flex items-center justify-between border-b border-neutral-200 bg-white px-6 py-3">
    <a href="/orders/<%= order.id %>" class="text-[14px] text-neutral-600 hover:text-blue-600">&larr; Kembali ke Order</a>
    <button type="button" onclick="window.print()"
      class="rounded-full bg-neutral-900 px-5 py-2 text-[14px] font-semibold text-white hover:bg-blue-700">
      Cetak Nota
    </button>
  </div>

  <div class="mx-auto max-w-[210mm] bg-white p-8 print:p-0">
    <div class="flex items-start justify-between border-b-2 border-neutral-900 pb-4">
      <div>
        <p class="font-mono text-[13px] font-semibold tracking-[0.2em] uppercase">Motoworks</p>
        <h1 class="mt-1 text-[22px] font-semibold"><%= settings.namaBengkel %></h1>
        <% if (settings.alamat) { %><p class="text-[13px] text-neutral-600"><%= settings.alamat %></p><% } %>
        <% if (settings.telepon) { %><p class="font-mono text-[13px] text-neutral-600"><%= settings.telepon %></p><% } %>
      </div>
      <div class="text-right">
        <p class="font-mono text-[11px] tracking-[0.2em] text-neutral-500 uppercase">Nota Service</p>
        <p class="mt-1 font-mono text-[18px] font-semibold"><%= order.nomorOrder %></p>
        <p class="text-[13px] text-neutral-600"><%= formatTanggalWaktu(order.tanggalMasuk) %></p>
        <p class="mt-1 inline-block rounded-full border border-neutral-300 px-3 py-0.5 text-[12px]">
          <%= statusLabel(order.statusOrder) %>
        </p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-6">
      <div>
        <p class="font-mono text-[11px] tracking-widest text-neutral-500 uppercase">Pelanggan</p>
        <p class="mt-1 text-[15px] font-medium">
          <%= order.customer && order.customer.nama ? order.customer.nama : 'Tanpa nama' %>
        </p>
        <% if (order.customer && order.customer.noHp) { %>
        <p class="font-mono text-[13px] text-neutral-600"><%= order.customer.noHp %></p>
        <% } %>
      </div>
      <div>
        <p class="font-mono text-[11px] tracking-widest text-neutral-500 uppercase">Kendaraan</p>
        <p class="mt-1 text-[15px] font-medium">
          <%= order.customer && order.customer.modelMotor ? order.customer.modelMotor : '-' %>
        </p>
        <% if (order.customer && order.customer.platMotor) { %>
        <p class="font-mono text-[13px] text-neutral-600"><%= order.customer.platMotor %></p>
        <% } %>
      </div>
    </div>

    <% if (order.keluhan || order.mekanik) { %>
    <div class="mt-4 rounded border border-neutral-200 px-4 py-3 text-[13px]">
      <% if (order.keluhan) { %><p><span class="text-neutral-500">Keluhan:</span> <%= order.keluhan %></p><% } %>
      <% if (order.mekanik) { %><p class="mt-1"><span class="text-neutral-500">Mekanik:</span> <%= order.mekanik %></p><% } %>
    </div>
    <% } %>

    <table class="mt-6 w-full text-left text-[14px]">
      <thead>
        <tr class="border-b-2 border-neutral-900">
          <th class="py-2 font-mono text-[11px] tracking-wider uppercase">Item</th>
          <th class="py-2 font-mono text-[11px] tracking-wider uppercase">Tipe</th>
          <th class="py-2 text-right font-mono text-[11px] tracking-wider uppercase">Qty</th>
          <th class="py-2 text-right font-mono text-[11px] tracking-wider uppercase">Harga</th>
          <th class="py-2 text-right font-mono text-[11px] tracking-wider uppercase">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(function (item) { %>
        <tr class="border-b border-neutral-200">
          <td class="py-2">
            <%= item.tipeItem === 'sparepart' ? (item.sparePart ? item.sparePart.nama : '-') : (item.serviceType ? item.serviceType.namaLayanan : '-') %>
          </td>
          <td class="py-2 text-[13px] text-neutral-500"><%= item.tipeItem %></td>
          <td class="py-2 text-right font-mono text-[13px]"><%= item.qty %></td>
          <td class="py-2 text-right font-mono text-[13px]"><%= formatRupiah(item.hargaSatuan) %></td>
          <td class="py-2 text-right font-mono text-[13px]"><%= formatRupiah(item.subtotal) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="mt-6 flex justify-end">
      <div class="w-full max-w-[280px] space-y-2 text-[14px]">
        <div class="flex justify-between"><span class="text-neutral-500">Total Jasa</span><span class="font-mono"><%= formatRupiah(order.totalJasa) %></span></div>
        <div class="flex justify-between"><span class="text-neutral-500">Total Sparepart</span><span class="font-mono"><%= formatRupiah(order.totalSparepart) %></span></div>
        <div class="flex justify-between border-t border-neutral-900 pt-2 text-[16px] font-semibold">
          <span>Total</span><span class="font-mono"><%= formatRupiah(order.totalKeseluruhan) %></span>
        </div>
        <div class="flex justify-between"><span class="text-neutral-500">Dibayar</span><span class="font-mono"><%= formatRupiah(sudahBayar) %></span></div>
        <div class="flex justify-between font-semibold">
          <span><%= sisa > 0 ? 'Sisa' : 'Status' %></span>
          <span class="font-mono"><%= sisa > 0 ? formatRupiah(sisa) : 'LUNAS' %></span>
        </div>
      </div>
    </div>

    <% if (order.payments.length) { %>
    <div class="mt-6">
      <p class="font-mono text-[11px] tracking-widest text-neutral-500 uppercase">Riwayat Pembayaran</p>
      <table class="mt-2 w-full max-w-[360px] text-left text-[13px]">
        <tbody>
          <% order.payments.forEach(function (payment) { %>
          <tr class="border-b border-neutral-200">
            <td class="py-1.5"><%= formatTanggalWaktu(payment.tanggalBayar) %></td>
            <td class="py-1.5 text-neutral-500"><%= payment.metodeBayar || 'Tunai' %></td>
            <td class="py-1.5 text-right font-mono"><%= formatRupiah(payment.jumlahBayar) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="mt-10 border-t border-neutral-200 pt-4 text-center">
      <p class="text-[13px] text-neutral-600">
        <%= settings.footerNota || 'Terima kasih atas kepercayaan Anda.' %>
      </p>
      <p class="mt-2 font-mono text-[10px] tracking-widest text-neutral-400 uppercase">
        Dicetak <%= formatTanggalWaktu(new Date()) %>
      </p>
    </div>
  </div>
</body>
</html>
